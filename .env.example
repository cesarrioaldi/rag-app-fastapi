# =====================================================
# rag-app-fastapi — template konfigurasi (.env)
# =====================================================
# Salin jadi .env setelah mengubah DB_NAME:
#   cp .env.example .env
#
# DB_NAME khusus project ini: "ragapp_fastapi".

# --- DATABASE ---
DB_NAME=ragapp_fastapi
DB_USER=macbook
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- EMBEDDING ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- RETRIEVAL ---
TOP_K=3
AMBANG_SKOR=0.35
